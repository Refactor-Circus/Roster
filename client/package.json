{
  "name": "@refactor-circus/roster-client",
  "version": "2.0.0",
  "description": "Typed fetch client for the Roster JSON API, generated from the package's openapi.json.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
