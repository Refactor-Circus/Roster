{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "refactor-circus/roster",
    "description": "User management",
    "keywords": [
        "laravel",
        "refactor-circus",
        "roster"
    ],
    "homepage": "https://github.com/Refactor-Circus/roster",
    "license": "MIT",
    "authors": [
        {
            "name": "Jay Fletcher",
            "email": "5743488+jayjfletcher@users.noreply.github.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "refactor-circus/keystone": "dev-main",
        "laravel/framework": "^13.35",
        "laravel/mcp": "^1.0.1"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pao": "^1.1.5",
        "laravel/pint": "^1.32.1",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.3.4",
        "pestphp/pest-plugin-browser": "^5.1.2",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "pestphp/pest-plugin-type-coverage": "^5.0.3",
        "phpstan/extension-installer": "^1.4.3",
        "refactor-circus/atrium": "dev-main",
        "refactor-circus/cortex": "dev-main",
        "refactor-circus/impex": "dev-main",
        "refactor-circus/keen": "dev-main",
        "refactor-circus/pennantplus": "dev-main",
        "refactor-circus/ringside": "dev-main",
        "refactor-circus/standards": "dev-main"
    },
    "conflict": {
        "refactor-circus/atrium": "<0.1.0"
    },
    "suggest": {
        "refactor-circus/atrium": "The Atrium dashboard: Roster's admin screens, widgets and search (dev-main).",
        "refactor-circus/cortex": "Lets Cortex agents use the Roster tools (dev-main).",
        "refactor-circus/guardian": "Single sign-on (OIDC, SAML, Entra ID) and SCIM provisioning for Roster's organizations (dev-main).",
        "refactor-circus/impex": "Required for CSV import and export (dev-main).",
        "refactor-circus/pennantplus": "Switch Roster in Atrium on and off with the RosterSupportFeature Pennant feature (dev-main).",
        "refactor-circus/keen": "Records Roster's changes in the suite-wide audit log (dev-main)."
    },
    "autoload": {
        "psr-4": {
            "RefactorCircus\\Roster\\": "src/",
            "RefactorCircus\\Roster\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RefactorCircus\\Roster\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:create-sqlite-db --ansi",
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse"
        ],
        "test:types": [
            "vendor/bin/pest --type-coverage --min=100 --exclude-testsuite=Browser"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel --exclude-testsuite=Browser"
        ],
        "test:browser": [
            "vendor/bin/pest --testsuite=Browser"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ],
        "local:install": [
            "@php bin/composer-local.php",
            "@putenv COMPOSER=composer.local.json",
            "@composer install"
        ],
        "local:update": [
            "@php bin/composer-local.php",
            "@putenv COMPOSER=composer.local.json",
            "@composer update"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "RefactorCircus\\Roster\\RosterServiceProvider"
            ],
            "aliases": {
                "Roster": "RefactorCircus\\Roster\\Facades\\Roster"
            }
        },
        "atrium": {
            "plugins": [
                "RefactorCircus\\Roster\\Atrium\\RosterPlugin"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true,
            "refactor-circus/ringside": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Refactor-Circus/Atrium.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Refactor-Circus/Cortex.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Refactor-Circus/Impex.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Refactor-Circus/PennantPlus.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Refactor-Circus/Keystone.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Refactor-Circus/Keen.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Refactor-Circus/Ringside.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Refactor-Circus/Standards.git"
        }
    ]
}
